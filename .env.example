# All optional; defaults shown
API_URL=https://data.elexon.co.uk/bmrs/api/v1/datasets/FUELHH
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=elexon.fuelhh
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
CHECKPOINT_PATH=state/checkpoint.json
# First run: start here (YYYY-MM-DD), otherwise INITIAL_LOOKBACK_DAYS before today
BACKFILL_START=
INITIAL_LOOKBACK_DAYS=7
REVISION_LOOKBACK_DAYS=2
# Elexon allows at most 7 days per request
CHUNK_DAYS=7
POLL_INTERVAL_SECONDS=1800
LOG_LEVEL=INFO

# Consumer (python -m consumer): Kafka -> LANDING_PATH/fuelhh/ingest_date=.../
# Keep the group id: changing it makes the consumer re-read the whole topic
CONSUMER_GROUP_ID=pulse-fuelhh-bronze
# Where the landing files go: a local folder, or GCS such as gs://pulse-lake/landing.
# Databricks reads the landing files from this same location.
LANDING_PATH=data/landing
# For gs:// paths: service-account key with Storage Object Creator on the bucket (keep it out of git)
GOOGLE_APPLICATION_CREDENTIALS=
BATCH_MAX_MESSAGES=500
BATCH_TIMEOUT_SECONDS=5
